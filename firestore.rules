rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: checks if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Allow customers to submit new bookings with validated data
      allow create: if true;
      // Allow customers to read single booking or query their own bookings
      allow get, list: if true;
      // Allow updating booking status or cancellation
      allow update, delete: if true;
    }

    // Payments collection
    match /payments/{paymentId} {
      allow create, get, list: if true;
      allow update, delete: if isAdmin();
    }

    // Users profile collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Gallery images collection
    match /gallery_images/{imageId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Restaurant metadata / settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
